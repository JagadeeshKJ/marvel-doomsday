    "@testing-library/react": "16.3.2",
    "@types/node": "25.0.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.1.9"
  }
}
